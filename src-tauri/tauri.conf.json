{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "translate",
  "version": "0.9.2",
  "identifier": "com.translate.qiumo",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0RTBCNDZERTJEODY1MzEKUldReFpkamliYlRnWlA2QjQ1bjR0UnVWS0RCMjNKRXBNUnQ1Q2hHR09Va1F1UnB5ZE5yOGgwS3kK",
      "endpoints": [
        "https://github.com/PengweeWang/translate/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
