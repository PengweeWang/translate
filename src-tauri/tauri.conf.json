{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "translate",
  "version": "0.1.0",
  "identifier": "com.translate.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/transp2.png",
      "icons/transp2.ico"
    ]
  }
}
